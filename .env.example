# Open Omada Device Agent example configuration
# Copy to .env and edit locally. Never commit .env.

# Controller transport
OMADA_CONTROLLER_HOST=omada-controller.example.net
OMADA_DISCOVERY_PORT=29810
OMADA_MANAGE_PORT=29814
OMADA_LOCAL_DISCOVERY_PORT=0
OMADA_DISCOVERY_INTERVAL=5
OMADA_TCP_TIMEOUT=15
OMADA_INFORM_INTERVAL=3
OMADA_RECONNECT_DELAY=3
OMADA_MANAGED_RECONNECT_ATTEMPTS=3

# Controller/site identifiers
# Controller ID: 32 characters. Site ID: 24 characters.
OMADA_CONTROLLER_ID=0123456789abcdef0123456789abcdef
# Preferred External Portal `site` parameter and site-scoped discovery target.
OMADA_SITE_ID=0123456789abcdef01234567
# Human-readable fallback used only when no site ID is available.
OMADA_SITE_NAME=Default
OMADA_DEST_OMADAC_ID=

# Reference AP identity
OMADA_DEVICE_MAC=02:00:00:00:00:01
OMADA_DEVICE_NAME=OpenOmada-AP
OMADA_DEVICE_MODEL=EAP110
OMADA_DEVICE_MODEL_VERSION=4.0
OMADA_DEVICE_HARDWARE_VERSION=4.0
OMADA_DEVICE_FIRMWARE_VERSION=5.0.4
OMADA_CUSTOMIZE_REGION=841

# Advertised IP. 0.0.0.0 lets the controller infer the transport source.
# Set to "auto" only if you intentionally want the agent to query a public-IP service.
OMADA_DEVICE_IP=0.0.0.0
OMADA_PUBLIC_IP_LOOKUP_URL=https://api.ipify.org
OMADA_PUBLIC_IP_LOOKUP_TIMEOUT=2

# Device Account credentials used by the legacy ECSP V2 verification flow.
OMADA_DEVICE_USERNAME=
OMADA_DEVICE_PASSWORD=
OMADA_DEVICE_CIPHER_TYPE=5

# ECSP identity
OMADA_ECSP_VERSION=2.3.0
OMADA_ECSP_VER_CAP=2

# TLS. Verification is off by default because device-management endpoints often
# use private/self-signed certificates. Enable it when your deployment has a
# trusted certificate or CA file.
OMADA_TLS_VERIFY=false
OMADA_TLS_CA_FILE=

# Minimal wired-uplink telemetry
OMADA_LAN_RATE=100
OMADA_LAN_DUPLEX=1
OMADA_LAN_PORT=LAN

# AP platform feature detection and reconciliation
OMADA_PLATFORM=auto
OMADA_RADIO_BANDS=2g
OMADA_MAX_SSIDS=4
OMADA_CAP_WPA3_PSK=false
OMADA_CAP_SSID_VLAN=false
OMADA_CAP_DYNAMIC_VLAN=false
OMADA_CAP_MANAGEMENT_VLAN=false
# Portal auto-enables on OpenWrt when openNDS and ndsctl are installed.
# Set OMADA_CAP_PORTAL=false only to explicitly reject portal WLANs.
# OMADA_CAP_PORTAL=true
OMADA_CAP_OPTION82=false
OMADA_CAP_CLIENT_RATE_LIMITS=false

# Optional OpenWrt targets for advanced AP reconciliation
OMADA_OPENWRT_BOOTSTRAP=true
OMADA_OPENWRT_BOOTSTRAP_LAN=true
OMADA_OPENWRT_LAN_INTERFACE=lan
OMADA_OPENWRT_LAN_BRIDGE=br-lan
OMADA_OPENWRT_LAN_IPADDR=192.168.1.1/24
OMADA_OPENWRT_BOOTSTRAP_OPENNDS=true
OMADA_OPENNDS_GATEWAY_PORT=2050
OMADA_OPENNDS_GATEWAY_NAME=
# Lab-only: opens SSH, LuCI HTTP, and LuCI HTTPS from the WAN zone.
OMADA_OPENWRT_ENABLE_WAN_MANAGEMENT=false
OMADA_OPENWRT_WAN_ZONE=wan
OMADA_MANAGEMENT_VLAN_INTERFACE=
OMADA_MANAGEMENT_VLAN_DEVICE=
OMADA_HOSTAPD_UBUS_IFACE=
OMADA_CLIENT_BLOCK_INTERFACE=
OMADA_CLIENT_RATE_LIMIT_INTERFACE=
OMADA_PORTAL_INTERFACE=
OMADA_PORTAL_REDIRECT_PORT=8080

# DHCP/client inform source
OMADA_DHCP_LEASE_FILE=/tmp/dhcp.leases

# Optional sysfs LED brightness control
OMADA_LED_BRIGHTNESS_PATH=
OMADA_LED_ON_VALUE=1
OMADA_LED_OFF_VALUE=0
OMADA_LED_TRIGGER_PATH=
OMADA_LED_LOCATE_TRIGGER=timer
OMADA_LED_DEFAULT_TRIGGER=none

# Optional state-file override
# OMADA_STATE_FILE=.omada-agent-state-020000000001.json
