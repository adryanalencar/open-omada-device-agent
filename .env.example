# Open Omada Device Agent example configuration
# Copy to .env and edit locally. Never commit .env.

# Controller transport
OMADA_CONTROLLER_HOST=omada-controller.example.net
OMADA_DISCOVERY_PORT=29810
OMADA_MANAGE_PORT=29814
OMADA_LOCAL_DISCOVERY_PORT=0
OMADA_DISCOVERY_INTERVAL=5
OMADA_TCP_TIMEOUT=15
OMADA_INFORM_INTERVAL=3
OMADA_RECONNECT_DELAY=3
OMADA_MANAGED_RECONNECT_ATTEMPTS=3

# Controller/site identifiers
# Controller ID: 32 characters. Site ID: 24 characters.
OMADA_CONTROLLER_ID=0123456789abcdef0123456789abcdef
OMADA_SITE_ID=0123456789abcdef01234567
OMADA_DEST_OMADAC_ID=

# Reference AP identity
OMADA_DEVICE_MAC=02:00:00:00:00:01
OMADA_DEVICE_NAME=OpenOmada-AP
OMADA_DEVICE_MODEL=EAP110
OMADA_DEVICE_MODEL_VERSION=4.0
OMADA_DEVICE_HARDWARE_VERSION=4.0
OMADA_DEVICE_FIRMWARE_VERSION=5.0.4
OMADA_CUSTOMIZE_REGION=841

# Advertised IP. 0.0.0.0 lets the controller infer the transport source.
# Set to "auto" only if you intentionally want the agent to query a public-IP service.
OMADA_DEVICE_IP=0.0.0.0
OMADA_PUBLIC_IP_LOOKUP_URL=https://api.ipify.org
OMADA_PUBLIC_IP_LOOKUP_TIMEOUT=2

# Device Account credentials used by the legacy ECSP V2 verification flow.
OMADA_DEVICE_USERNAME=
OMADA_DEVICE_PASSWORD=
OMADA_DEVICE_CIPHER_TYPE=5

# ECSP identity
OMADA_ECSP_VERSION=2.3.0
OMADA_ECSP_VER_CAP=2

# TLS. Verification is off by default because device-management endpoints often
# use private/self-signed certificates. Enable it when your deployment has a
# trusted certificate or CA file.
OMADA_TLS_VERIFY=false
OMADA_TLS_CA_FILE=

# Minimal wired-uplink telemetry
OMADA_LAN_RATE=100
OMADA_LAN_DUPLEX=1
OMADA_LAN_PORT=LAN

# Optional state-file override
# OMADA_STATE_FILE=.omada-agent-state-020000000001.json
